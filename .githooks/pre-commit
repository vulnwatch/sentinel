#!/usr/bin/env bash
set -euo pipefail

echo "Running pre-commit checks..."

echo "  ruff check..."
(cd backend && uv run --locked ruff check .)

echo "  ruff format..."
(cd backend && uv run --locked ruff format --check .)

echo "  mypy..."
(cd backend && uv run --locked mypy app tests alembic)

echo "  unit tests..."
# Exit code 5 = "no tests collected" (no @pytest.mark.unit tests yet).
# Treat it as success so the hook doesn't block commits before the
# first unit test is added. -x stops at the first failure so its
# location is always the last thing printed, instead of being pushed
# out of view by the remaining tests in the run.
# The suite runs in parallel pytest-xdist workers, one per CPU up to 8;
# set PYTEST_XDIST_AUTO_NUM_WORKERS to use fewer. The marker expression
# must stay exactly `unit`: only then does the harness skip the
# PostgreSQL/Redis containers, so committing needs no Docker daemon. See
# docs/features/platform/testing-strategy.md (Parallel Execution).
(cd backend && uv run --locked pytest -m unit -n auto --maxprocesses 8 \
    --max-worker-restart 0 --no-header -q -x) || [ $? -eq 5 ]

# --- Shell lint (shellcheck, shfmt, actionlint) ---
# Lints the staged shell scripts and hooks with shellcheck and shfmt, and
# the staged workflows with actionlint, from the pinned images that the
# Shell Lint job of ci.yml runs. When Docker cannot run them, the script
# warns and the commit proceeds — CI remains the authoritative gate.
# See docs/conventions.md (Shell Scripting).
echo "  shell lint..."
scripts/lint-shell.sh --staged

# --- Secret scanning (gitleaks) ---
# Scans staged changes for secrets. Local-only: there is no CI job or
# GitHub Action for secret scanning (see
# docs/features/platform/testing-strategy.md, Pre-Commit Hooks), so
# this hook is the only enforcement point. No version is pinned; any
# recent release is expected to behave consistently for this use case.
echo "  gitleaks..."
if command -v gitleaks >/dev/null 2>&1; then
    gitleaks git --staged
else
    echo "Warning: gitleaks not installed; skipping (local-only check, no CI enforcement)." >&2
fi
